<?xml version="1.0" encoding="utf-8"?>
<!-- Keep NavigationRecyclerView measured and receiving raw WindowInsets even when Compose
     displays the navigation pane. The legacy view remains the TV/D-pad fallback. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <me.zhanghai.android.files.navigation.NavigationRecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeNavigationView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
